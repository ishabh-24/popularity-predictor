# Copy to `.env` and fill in.

# --- Kaggle API (audio features CSV) ---
# Create token: https://www.kaggle.com/settings → API → Create New Token
# Either place kaggle.json in ~/.kaggle/ OR set:
KAGGLE_USERNAME=
KAGGLE_KEY=

# Dataset slug (owner/dataset-name) — used with: python -m src.etl.build_dataset --download-kaggle ...
KAGGLE_DATASET=
# Optional: exact CSV filename inside the downloaded zip. If empty, first *.csv in KAGGLE_DOWNLOAD_DIR is used.
KAGGLE_FILENAME=
KAGGLE_DOWNLOAD_DIR=data/kaggle_raw

# --- Billboard (chart labels / rankings) ---
BILLBOARD_CHART_NAME=hot-100
# Optional defaults for merge_kaggle_billboard (if you omit CLI flags):
# BILLBOARD_YEAR_RANGE=2000-2019
# BILLBOARD_SAMPLE=monthly

# --- Join quality ---
ETL_MIN_MATCH_SCORE=0.75

